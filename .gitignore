# ---------------------------------------------------------------------------
# Secrets - never commit the Dataverse API token
# ---------------------------------------------------------------------------
.env
*.token

# ---------------------------------------------------------------------------
# Data. None of this is committed: the raw files are 20.6 GB and the processed
# store is a 341 MB binary. Both are regenerated by `scripts/01_ingest.py`.
# ---------------------------------------------------------------------------
data/raw/
data/processed/
*.memmap
*.memmap.part
*.txt.part

# Run logs are large, machine-specific and reproducible, so they stay out. The
# CSV tables in `results/` and the figures ARE committed on purpose: they are the
# evidence the report cites, and regenerating them takes hours on the reference
# hardware.
results/*.log

# Intermediate produced on the way to report.pdf; the PDF itself is committed.
report/report.html

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
$RECYCLE.BIN/
