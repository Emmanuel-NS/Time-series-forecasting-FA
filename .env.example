# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.
#
# The Milan dataset on Harvard Dataverse is protected by a download guestbook,
# so anonymous API requests are refused with HTTP 400. Logging in makes
# Dataverse record the guestbook entry automatically, and the API token is how
# a script authenticates.
#
# To obtain one (free, no institutional affiliation required):
#   1. Register or sign in at https://dataverse.harvard.edu
#   2. Open the account menu (top right) -> API Token
#   3. Create Token, then copy the UUID below
DATAVERSE_API_TOKEN=00000000-0000-0000-0000-000000000000

# The dataset's guestbook (id 96, "Privacy risk assessment") requires an email
# address. These values are submitted once per file download, exactly as the
# web interface would submit them.
DATAVERSE_NAME=Your Name
DATAVERSE_EMAIL=you@example.com
DATAVERSE_INSTITUTION=Your Institution
DATAVERSE_POSITION=Student

# Concurrent HTTP range requests per file. Harvard throttles per connection,
# so this is what actually determines download speed. Keep it modest.
MILAN_DOWNLOAD_WORKERS=8

# Optional: directory already containing manually downloaded raw day files.
# The ingestion pipeline checks here before downloading anything.
# MILAN_RAW_DIR=C:\Users\me\Downloads\dataverse_files
